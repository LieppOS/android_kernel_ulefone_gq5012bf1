# SPDX-License-Identifier: GPL-2.0
#
# Ulefone Armor 29 Pro Thermal (GQ5012BF1 / MT6878T) TEE selection.
#
# Stock evidence:
#   - The stock vendor module set contains tkcore.ko, tkcore_drv.ko,
#     ffa_v10.ko, tmem_ffa.ko and microarray_fp_tee.ko.
#   - The stock rpmb-mtk.ko has no Trustonic/mobicore imports and no
#     genl/netlink imports.  It imports only rpmb_cmd_req,
#     rpmb_get_rw_size and ufs_mtk_rpmb_get_raw_dev.
#   - No stock module contains mCrpModule, mobicore or Trustonic
#     strings.
#
# Therefore this device uses the TrustKernel kernel-side TEE stack, not
# the Trustonic GUD/mobicore stack.  rpmb-mtk.ko must be built without
# the Trustonic GP/DCI path so that it does not acquire the donor-only
# mCrpModule-ffa dependency.
#
# Apply this fragment after the MediaTek base defconfig, for example:
#   make O=out ARCH=arm64 mgk_64_k61_defconfig
#   scripts/kconfig/merge_config.sh -O out out/.config \
#       arch/arm64/configs/gq5012bf1.config
#   make O=out ARCH=arm64 olddefconfig

# CONFIG_TRUSTONIC_TEE_SUPPORT is not set
# CONFIG_TRUSTONIC_TRUSTED_UI is not set
# CONFIG_MICROTRUST_TEE_SUPPORT is not set
# CONFIG_MTK_TEE_GP_SUPPORT is not set

CONFIG_TRUSTKERNEL_TEE_SUPPORT=m
CONFIG_TRUSTKERNEL_TEE_FP_SUPPORT=m
CONFIG_TRUSTKERNEL_TEE_RPMB_SUPPORT=m

CONFIG_ARM_FFA_TRANSPORT=m
CONFIG_MTK_FFA_VENDOR_TRANSPORT=m

# Camera provider selection.
#
# Stock GQ5012BF1 ships exactly these camera provider modules:
#   mtk_ccuv.ko, mtk-cam-isp7sp.ko, mtk_imgsys_isp7sp.ko,
#   camera_dpe_isp7sp.ko, imgsensor.ko, imgsensor-glue.ko.
# It has no mtk_ccu.ko, ccu.ko, imgsensor_isp6s.ko, mtk-cam-isp7s.ko,
# mtk-cam-isp.ko, mtk_imgsys_isp7s.ko or in-tree camera_dpe_isp70.ko.
#
# CONFIG_MTK_CCU_RPROC is retained because the external mtkcam/ccusys
# Kbuild uses it to build mtk_ccuv.ko; the competing in-tree mtk_ccu.ko
# is gated by CONFIG_MTK_CCU_RPROC_LEGACY instead.
# CONFIG_MTK_CCU is not set
CONFIG_MTK_CCU_RPROC=m
# CONFIG_MTK_CCU_RPROC_LEGACY is not set
# CONFIG_MTK_CCU_MSSV is not set
# CONFIG_MTK_CCU_DEBUG is not set

# The external v4l2 imgsensor provider is selected; the legacy in-tree
# imgsensor_isp6s.ko provider is not part of the stock image.
# CONFIG_MTK_IMGSENSOR is not set
CONFIG_MTK_V4L2_IMGSENSOR=m

# Only the ISP7SP camsys family is built by mtkcam/camsys/Kbuild.
CONFIG_VIDEO_MTK_ISP_CAMSYS=m
CONFIG_MTK_CAMERA_CAMSYS_7SP=y
# CONFIG_MTK_CAMERA_CAMSYS_7S is not set
# CONFIG_MTK_CAMERA_CAMSYS_7_1 is not set

# Only the ISP7SP depth engine is built.  The in-tree ISP7/ISP7S DPE
# providers are not in the stock module set.
# CONFIG_MTK_CAMERA_DPE_ISP7S is not set
# CONFIG_MTK_CAMERA_DPE_ISP7 is not set
# CONFIG_MTK_CAMERA_DPE_ISP6S is not set
CONFIG_MTK_CAMERA_DPE_ISP7SP=m

# In-tree imgsys: keep the shared v4l2/cmdq/HCP providers and the ISP7SP
# engine; do not build the competing ISP7S engine.
CONFIG_VIDEO_MTK_ISP_IMGSYS=m
CONFIG_VIDEO_MTK_ISP_IMGSYS_CMDQ=m
CONFIG_VIDEO_MTK_ISP_IMGSYS_7SP=m
# CONFIG_VIDEO_MTK_ISP_IMGSYS_7S is not set
CONFIG_VIDEO_MTK_ISP_HCP=m
CONFIG_VIDEO_MTK_ISP_IPESYS=m

# Stock does not ship camera_mem.ko and no stock camera module imports it.
# CONFIG_MTK_CAMERA_MEM_SUPPORT is not set
