#
# OEM device bootinfo configuration
#

config OEM_DEVINFO
    tristate "device boot info"
    help
	Say Y here if you want to enable device boot info.
	If unsure, say N.

config OEM_BOOTINFO
    tristate "bootinfo"
    help
	Say Y here if you want to enable bootinfo.
	If unsure, say N.

config OEM_BOARDID
    tristate "boardid"
    help
	Say Y here if you want to enable boardid.
	If unsure, say N.

config OEM_HWINFO
    tristate "hwinfo"
    help
	Say Y here if you want to enable hwinfo.
	If unsure, say N.

config OEM_CAMINFO
    bool "camera identity storage"
    help
	  Exports the camera module id / depth-camera serial arrays that the
	  ODM bootinfo driver provides to the camera stack.  Split out because
	  the full bootinfo driver needs ODM charger/typec/haptic providers that
	  are not part of this source tree.
