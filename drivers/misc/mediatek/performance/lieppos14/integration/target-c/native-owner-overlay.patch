 obj-$(CONFIG_MTK_PERFORMANCE_MODULE) += mtk_ioctl_powerhal.o
+endif
 mtk_ioctl_powerhal-objs += $(MTK_IOCTL_POWERHAL_SRC)
 
 # mtk_perf_ioctl_magt
