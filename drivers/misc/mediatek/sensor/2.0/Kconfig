config YFT_DEVINFO
	tristate "Ulefone/YFT device information provider (yft_devinfo)"
	default n
	help
	  YFT (Ulefone) device-information provider. It is the shared provider
	  consumed by the touch, sensor, fuel-gauge and camera modules on the
	  GQ5012BF1 platform (hf_manager, focaltech, hynitron, sh366003_fg, ...).
	  Source reconstructed by LieppOS from the stock vendor_dlkm binary.
