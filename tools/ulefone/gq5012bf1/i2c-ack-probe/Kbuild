# Module names differ from sources so new builds can coexist with permanently
# loaded earlier builds (ois_ackprobe, ois_i2cpeek v1) until reboot.
obj-m := ois_ackscan.o ois_i2cpeek2.o
ois_ackscan-y := ois_ackprobe.o
ois_i2cpeek2-y := ois_i2cpeek.o
ccflags-y += -Werror
