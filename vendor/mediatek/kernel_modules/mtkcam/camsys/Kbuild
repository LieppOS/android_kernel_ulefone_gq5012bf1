# Support GKI mixed build
ifeq ($(DEVICE_MODULES_PATH),)
DEVICE_MODULES_PATH = $(srctree)
else
LINUXINCLUDE := $(DEVCIE_MODULES_INCLUDE) $(LINUXINCLUDE)
endif

KO_MTKCAM_CODE_PATH := $(if $(filter /%,$(src)),,$(srctree)/)$(src)/..

$(info KO_MTKCAM_CODE_PATH=$(KO_MTKCAM_CODE_PATH))

subdir-ccflags-y += -I$(KO_MTKCAM_CODE_PATH)/
subdir-ccflags-y += -I$(KO_MTKCAM_CODE_PATH)/include

# The camsys provider families all use the same CONFIG_VIDEO_MTK_ISP_CAMSYS
# symbol, so selecting that symbol used to build mtk-cam-isp, mtk-cam-isp7s
# and mtk-cam-isp7sp together.  The GQ5012BF1 stock vendor image ships only
# mtk-cam-isp7sp.ko; build exactly one family with a deterministic priority.
ifneq ($(CONFIG_MTK_CAMERA_CAMSYS_7SP),)
obj-y += isp7sp/
else ifneq ($(CONFIG_MTK_CAMERA_CAMSYS_7S),)
obj-y += isp7s/
else ifneq ($(CONFIG_MTK_CAMERA_CAMSYS_7_1),)
obj-y += isp7_1/
endif
obj-$(CONFIG_RPMSG_MTK_CCD) += rpmsg/
obj-$(CONFIG_MTK_CCD_REMOTEPROC) += remoteproc/
